# File .env đặt cạnh docker-compose.prod.yml trên VPS (GitHub Actions tự ghi khi deploy).
# Chỉ chứa biến dùng để điền vào docker-compose.prod.yml, KHÔNG chứa bí mật.

# Tên miền chính (không có https://, không có www)
DOMAIN=quangtm.site

# Email nhận thông báo của Let's Encrypt (sắp hết hạn chứng chỉ...)
LETSENCRYPT_EMAIL=you@example.com

# Nơi chứa image trên GitHub Container Registry (chữ thường)
IMAGE_PREFIX=ghcr.io/mquanggdev/ecommerce-monorepo

# Bản đang chạy - scripts/deploy.sh tự cập nhật, không cần sửa tay
IMAGE_TAG=latest
