# Questa Booking (dự án riêng, deploy riêng) chạy chung VPS:
# booking.${DOMAIN} → Nginx riêng của Booking, grafana.${DOMAIN} → Grafana của Booking.
# Các container đó nằm trong network Docker "edge" mà Nginx này cũng tham gia
# (xem docker-compose.prod.yml).
#
# Container của Booking có thể chưa tồn tại (chưa deploy, đang khởi động lại):
# địa chỉ đặt trong biến, Docker DNS chỉ phân giải khi có request, nên Nginx này
# luôn khởi động được. Booking lỗi thì chỉ booking.* trả 502, website không bị ảnh hưởng.
#
# Chứng chỉ: /etc/letsencrypt/live/booking.${DOMAIN}/ dùng cho cả hai tên,
# container certbot gia hạn cùng chứng chỉ của ${DOMAIN}.

# ---------- HTTP: chỉ để Let's Encrypt xác minh, còn lại chuyển sang HTTPS ----------
server {
    listen 80;
    listen [::]:80;
    server_name booking.${DOMAIN} grafana.${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------- Booking ----------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name booking.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/booking.${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/booking.${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    resolver 127.0.0.11 valid=30s ipv6=off;
    client_max_body_size 1m;

    location / {
        set $booking http://questa-booking-nginx;
        proxy_pass $booking;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # WebSocket: sơ đồ ghế, hàng chờ ảo, trang theo dõi mở bán
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_read_timeout 1h;
    }
}

# ---------- Grafana (công khai, chỉ xem) ----------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name grafana.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/booking.${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/booking.${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    resolver 127.0.0.11 valid=30s ipv6=off;

    location / {
        set $grafana http://questa-booking-grafana:3000;
        proxy_pass $grafana;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Grafana Live (dashboard tự làm mới)
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
    }
}
