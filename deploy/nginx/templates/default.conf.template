# Nginx tự thay ${DOMAIN} khi khởi động (các biến của Nginx như $host không bị thay vì không phải biến môi trường).
# Chứng chỉ HTTPS lấy bằng deploy/scripts/init-ssl.sh trước lần chạy đầu tiên.

upstream ecommerce {
    server ecommerce:3000;
    keepalive 16;
}

upstream file_manager {
    server file-manager:4000;
    keepalive 8;
}

# WebSocket (chat dùng Socket.IO) cần "Connection: upgrade"; request thường để trống
# để giữ kết nối keepalive tới container
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

# ---------- HTTP: chỉ để Let's Encrypt xác minh tên miền, còn lại chuyển sang HTTPS ----------
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN} www.${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://${DOMAIN}$request_uri;
    }
}

# ---------- www → tên miền chính (một địa chỉ duy nhất cho cookie và kiểm tra Referer của ảnh) ----------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    return 301 https://${DOMAIN}$request_uri;
}

# ---------- Website ----------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    # Header HSTS do Helmet trong app đặt (không thêm ở đây để khỏi bị gửi trùng)

    # Upload tối đa 20MB/file (giới hạn của file-manager) + phần còn lại của form
    client_max_body_size 25m;

    gzip on;
    gzip_proxied any;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;

    # Khai báo header MỘT lần ở đây. Lưu ý: location nào có proxy_set_header riêng sẽ bỏ hết các dòng này,
    # nên các location bên dưới không đặt thêm proxy_set_header.
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;

    # Ảnh/file upload → file-manager (file-manager tự kiểm tra Referer)
    location /media/ {
        proxy_pass http://file_manager;
    }

    # Socket.IO (chat): giữ kết nối WebSocket lâu
    location /socket.io/ {
        proxy_pass http://ecommerce;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # Còn lại → website. Timeout dài hơn mặc định cho các thao tác gọi dịch vụ ngoài (phí ship, tạo đơn, xuất PDF)
    location / {
        proxy_pass http://ecommerce;
        proxy_read_timeout 120s;
    }
}
