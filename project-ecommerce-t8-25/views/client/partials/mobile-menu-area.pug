//- Menu trên điện thoại: dùng cùng dữ liệu với menu máy tính (categoryProductList, categoryArticleList)
div(class="mobile_menu_area")
  #offcanvasWithBothOptions.offcanvas.offcanvas-start(
    tabindex="-1"
    data-bs-scroll="true"
    )
    button.btn-close(
      aria-label="Đóng"
      data-bs-dismiss="offcanvas"
      type="button"
      )
      i.fal.fa-times
    .offcanvas-body
      ul.d-flex.flex-wrap(class="mobile_menu_header")
        li
          a(href="/compare")
            b
              img.img-fluid(
                alt="So sánh"
                src="/client/assets/images/compare_black.svg"
                )
        li
          a(href="/wishlist")
            b
              img.img-fluid(
                alt="Yêu thích"
                src="/client/assets/images/love_black.svg"
                )
        li
          a(href="/cart")
            b
              img.img-fluid(
                alt="Giỏ hàng"
                src="/client/assets/images/cart_black.svg"
                )
        li
          a(href=(accountUser ? "/dashboard" : "/auth/login"))
            b
              img.img-fluid(
                alt="Tài khoản"
                src="/client/assets/images/user_icon_black.svg"
                )
      form(
        class="mobile_menu_search"
        action="/product/category"
        method="GET"
        )
        input(
          placeholder="Tìm sản phẩm..."
          type="text"
          name="keyword"
          )
        button(type="submit")
          i.far.fa-search
      div(class="mobile_menu_item_area")
        ul#pills-tab.nav.nav-pills(role="tablist")
          li.nav-item(role="presentation")
            button#pills-home-tab.nav-link.active(
              aria-selected="true"
              aria-controls="pills-home"
              role="tab"
              type="button"
              data-bs-target="#pills-home"
              data-bs-toggle="pill"
              ) Danh mục
          li.nav-item(role="presentation")
            button#pills-profile-tab.nav-link(
              aria-selected="false"
              aria-controls="pills-profile"
              role="tab"
              type="button"
              data-bs-target="#pills-profile"
              data-bs-toggle="pill"
              ) Menu
        #pills-tabContent.tab-content
          #pills-home.tab-pane.fade.show.active(
            tabindex="0"
            aria-labelledby="pills-home-tab"
            role="tabpanel"
            )
            ul(class="main_mobile_menu")
              each item in categoryProductList
                if (item.status == "active")
                  if (item.children && item.children.length)
                    li(class="mobile_dropdown")
                      a(href=`/product/category/${item.slug}`) #{item.name}
                      ul(class="inner_menu")
                        each child in item.children
                          if (child.status == "active")
                            li
                              a(href=`/product/category/${child.slug}`) #{child.name}
                  else
                    li
                      a(href=`/product/category/${item.slug}`) #{item.name}
          #pills-profile.tab-pane.fade(
            tabindex="0"
            aria-labelledby="pills-profile-tab"
            role="tabpanel"
            )
            ul(class="main_mobile_menu")
              li
                a(href="/") Trang chủ
              li
                a(href="/product/category") Tất cả sản phẩm
              li(class="mobile_dropdown")
                a(href="#") Bài viết
                ul(class="inner_menu")
                  each item in categoryArticleList
                    if (item.status == "active")
                      li
                        a(href=`/article/category/${item.slug}`) #{item.name}
              li
                a(href="/cart") Giỏ hàng
              li
                a(href="/wishlist") Yêu thích
              li
                a(href="/compare") So sánh
              if (accountUser)
                li
                  a(href="/dashboard") Tài khoản
                li
                  a(href="/dashboard/order/list") Đơn hàng của tôi
                li
                  a(href="/auth/logout") Đăng xuất
              else
                li
                  a(href="/auth/login") Đăng nhập
                li
                  a(href="/auth/register") Đăng ký
