footer(
  style="background: url(/client/assets/images/footer_2_bg_2.jpg);"
  class="footer_2 pt_100"
  )
  .container
    .row.justify-content-between
      .col-xl-3.col-md-6.col-lg-3.wow.fadeInUp(data-wow-delay=".7s")
        div(class="footer_2_logo_area")
          a(
            href="/"
            class="footer_logo"
            )
            img.img-fluid.w-100(
              alt="Zenis"
              src="/client/assets/images/footer_logo_2.png"
              )
          p
            | Thời trang nam đơn giản, dễ phối và bền bỉ. Áo, quần, áo khoác và phụ kiện cho đi làm lẫn đi chơi.
      .col-xl-2.col-sm-6.col-md-4.col-lg-2.wow.fadeInUp(data-wow-delay="1s")
        div(class="footer_link")
          h3 Danh mục
          ul
            each item in categoryProductList
              if (item.status == "active")
                li
                  a(href=`/product/category/${item.slug}`) #{item.name}
      .col-xl-2.col-sm-6.col-md-4.col-lg-2.wow.fadeInUp(data-wow-delay="1.3s")
        div(class="footer_link")
          h3 Bài viết
          ul
            each item in categoryArticleList
              if (item.status == "active")
                li
                  a(href=`/article/category/${item.slug}`) #{item.name}
      .col-xl-2.col-sm-6.col-md-4.col-lg-2.wow.fadeInUp(data-wow-delay="1.6s")
        div(class="footer_link")
          h3 Tài khoản
          ul
            if (accountUser)
              li
                a(href="/dashboard") Tổng quan
              li
                a(href="/dashboard/order/list") Đơn hàng của tôi
            else
              li
                a(href="/auth/login") Đăng nhập
              li
                a(href="/auth/register") Đăng ký
            li
              a(href="/cart") Giỏ hàng
            li
              a(href="/wishlist") Yêu thích
            li
              a(href="/compare") So sánh sản phẩm
      .col-xl-3.col-sm-6.col-md-4.col-lg-3.wow.fadeInUp(data-wow-delay="1.9s")
        div(class="footer_link footer_logo_area")
          h3 Hỗ trợ
          p
            | Cần tư vấn chọn size hay hỏi về đơn hàng? Đăng nhập và nhắn tin cho chúng tôi qua khung chat ở góc màn hình.
    .row
      .col-12
        div(class="footer_copyright mt_75")
          p
            | Bản quyền ©
            b Zenis
            | #{new Date().getFullYear()}.
          ul.payment
            li Thanh toán qua:
            li
              img.img-fluid.w-100(
                alt="payment"
                src="/client/assets/images/footer_payment_icon_1.jpg"
                )
            li
              img.img-fluid.w-100(
                alt="payment"
                src="/client/assets/images/footer_payment_icon_2.jpg"
                )
            li
              img.img-fluid.w-100(
                alt="payment"
                src="/client/assets/images/footer_payment_icon_3.jpg"
                )
