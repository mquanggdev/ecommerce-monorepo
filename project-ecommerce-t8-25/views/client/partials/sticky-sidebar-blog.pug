div(id="sticky_sidebar")
  .wow.fadeInRight(class="blog_details_right")
    div(class="blog_details_right_header sidebar_blog")
      h3 Bài Viết Phổ Biến
      each item in popularBlogList
        .d-flex.flex-wrap(class="popular_blog")
          div(class="popular_blog_img")
            img.img-fluid.w-100(
              alt="img" 
              src=`${domainPublic}${item.avatar}`
              )
          div(class="popular_blog_text")
            p
              span
                img.img-fluid.w-100(
                  alt="icon" 
                  src="/client/assets/images/calender.png"
                  )
              | #{item.createdAtFormat}
            a.title.w-100(href=`/article/detail/${item.slug}`)
              | #{item.name}
    div(class="blog_details_right_header")
      h3 Danh Mục Phổ Biến
      ul(class="sidebar_blog_category")
        each item in popularCategoryBlogList
          li
            a(href=`/article/category/${item.slug}`)
              p #{item.name}
              span (#{item.totalRecord})
    div(class="blog_details_right_header")
      h3 Tìm kiếm phổ biến
      ul.d-flex.flex-wrap(class="blog_details_tag")
        li
          a(href="/product/category?keyword=áo thun") áo thun
        li
          a(href="/product/category?keyword=sơ mi") sơ mi
        li
          a(href="/product/category?keyword=polo") polo
        li
          a(href="/product/category?keyword=quần jean") quần jean
        li
          a(href="/product/category?keyword=quần kaki") quần kaki
        li
          a(href="/product/category?keyword=áo khoác") áo khoác
        li
          a(href="/product/category?keyword=hoodie") hoodie
        li
          a(href="/product/category?keyword=blazer") blazer
        li
          a(href="/product/category?keyword=thắt lưng") thắt lưng
    div(class="blog_details_right_header")
      div(class="blog_seidebar_add")
        img.img-fluid.w-100(
          alt="blog add" 
          src="/client/assets/images/seed/blog-sidebar-ad.jpg"
          )
        .text
          h4 Lịch lãm mỗi ngày
          a(
            tabindex="-1" 
            href="/product/category/blazer-nam" 
            class="common_btn"
            )
            | Mua ngay
            i.fas.fa-long-arrow-right(aria-hidden="true")