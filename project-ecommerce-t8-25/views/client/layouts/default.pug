doctype html
html(lang="vi")
  head
    script.
      const domainPublic = "#{domainPublic}";
    meta(charset="UTF-8")
    meta(
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0, user-scalable=no, target-densityDpi=device-dpi" 
      name="viewport"
      )
    
    //- SEO: trang công khai truyền "seo" (helpers/seo.helper.ts). Trang không truyền (giỏ hàng, tài khoản...)
    //- chỉ có tiêu đề kèm tên thương hiệu và bị chặn index.
    - const brandTitle = (pageTitle && !`${pageTitle}`.toLowerCase().includes(siteInfo.name.toLowerCase())) ? `${pageTitle} | ${siteInfo.name}` : (pageTitle || siteInfo.name)
    title #{seo ? seo.title : brandTitle}
    if seo
      meta(name="description" content=seo.description)
      if seo.keywords && seo.keywords.length > 0
        meta(name="keywords" content=seo.keywords.join(", "))
    meta(
      name="robots",
      content=`${seo && seo.robots && seo.robots.index ? 'index' : 'noindex'}, ${seo && seo.robots && seo.robots.follow ? 'follow' : 'nofollow'}`
    )

    //- Tránh duplicate content (Google index đúng URL)
    link(rel="canonical" href=canonicalUrl)

    //- Open Graph (chia sẻ link lên Facebook, Zalo...)
    meta(property="og:site_name" content=siteInfo.name)
    meta(property="og:locale" content="vi_VN")
    meta(property="og:url" content=canonicalUrl)
    if seo
      meta(property="og:type" content=(seo.type == "article" ? "article" : (seo.type == "product" ? "product" : "website")))
      meta(property="og:title" content=seo.og.title)
      meta(property="og:description" content=seo.og.description)
      meta(property="og:image" content=seo.og.image)
      meta(name="twitter:card" content="summary_large_image")

    //- Dữ liệu cấu trúc (tên website, sản phẩm); thoát "<" để nội dung không đóng được thẻ script
    if seo && seo.jsonLd
      each item in seo.jsonLd
        script(type="application/ld+json")!= item

    //- Biểu tượng: Google cần ảnh có kích thước là bội số của 48px
    link(href=`/client/assets/images/questa-mark.svg?v=${assetVersion}` type="image/svg+xml" rel="icon")
    link(href=`/client/assets/images/favicon-48.png?v=${assetVersion}` type="image/png" sizes="48x48" rel="icon")
    link(href=`/client/assets/images/favicon-192.png?v=${assetVersion}` type="image/png" sizes="192x192" rel="icon")
    link(href=`/client/assets/images/apple-touch-icon.png?v=${assetVersion}` rel="apple-touch-icon")

    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/notyf@3/notyf.min.css")
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/openlayers@4.6.5/dist/ol.min.css")
    link(
      href=`/client/assets/css/all.min.css?v=${assetVersion}` 
      rel="stylesheet"
      )
    link(
      href=`/client/assets/css/bootstrap.min.css?v=${assetVersion}` 
