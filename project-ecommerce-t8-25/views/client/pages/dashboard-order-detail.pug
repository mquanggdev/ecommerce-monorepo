extends ../layouts/default.pug
include ../mixins/page-banner.pug
include ../mixins/order-cancel.pug
include ../mixins/order-invoice.pug

block main
  //
    =========================
    PAGE BANNER START
    ==========================
  +page-banner(
    {
      name: pageTitle,
    },
    `/dashboard/order/detail/${orderDetail.id}`
  )
  //
    =========================
    PAGE BANNER START
    ==========================

  //
    ============================
    DSHBOARD START
    =============================
  section.dashboard(class="mb_100")
    .container
      .row
        .col-xl-3.wow.fadeInUp
          include ../partials/dashboard-sidebar.pug
        .col-xl-9.wow.fadeInRight
          div(class="dashboard_content mt_100")
            h3(class="dashboard_title")
              | #{pageTitle}
              a(
                href="/dashboard/order/list" 
                class="back_btn common_btn"
                ) Quay lại
            div(class="dashboard_order_invoice_area")
              +order-invoice(orderDetail)
                  div(class="dashboard_invoice_footer")
                    h4 Ghi chú
                    div #{orderDetail.note}
                    if orderDetail.orderStatus == "pending" && orderDetail.paymentStatus == "paid"
                      p(class="order_contact_note")
                        | Đơn đã thanh toán. Muốn hủy đơn, vui lòng liên hệ shop qua hotline <a href="tel:0918079395">0918 079 395</a> để được hủy và hoàn tiền.
                    .order_detail_actions
                      a(
                        href=`/order/export-pdf?orderCode=${orderDetail.code}&phone=${orderDetail.phone}`
                        class="common_btn"
                        ) In hóa đơn
                      +order-cancel-button(orderDetail, "common_btn")

  +order-cancel-modal(cancelReasonList)
