//- Thông tin đơn + bảng sản phẩm, dùng chung cho trang đơn trong tài khoản và trang tra cứu đơn.
//- Phần chân (ghi chú, nút) truyền vào qua block.
mixin order-invoice(orderDetail)
  div(class="dashboard_order_invoice")
    div(class="dashboard_invoice_header")
      .text
        h2 Thông tin đơn hàng
        ul
          li
            span Họ tên:
            | #{orderDetail.fullName}
          li
            span Số điện thoại:
            | #{orderDetail.phone}
          li
            span Địa chỉ:
            | #{orderDetail.address}
          li
            span Ngày đặt hàng:
            | #{orderDetail.createdAt.toLocaleString('vi-VN')}
          li
            span Phương thức thanh toán:
            +payment-method-name(orderDetail)
          li
            span Trạng thái thanh toán:
            case orderDetail.paymentStatus
              when "unpaid"
                | Chưa thanh toán
              when "paid"
                | Đã thanh toán
              when "refunded"
                | Đã hoàn tiền
          li
            span Trạng thái đơn hàng:
            case orderDetail.orderStatus
              when "pending"
                | Chờ xác nhận
              when "confirmed"
                | Đã xác nhận
              when "shipping"
                | Đang giao
              when "completed"
                | Giao thành công
              when "cancelled"
                | Đã hủy
              when "returned"
                | Đã trả hàng
          if orderDetail.orderStatus == "cancelled" && orderDetail.cancelledAt
            li
              span Hủy lúc:
              | #{orderDetail.cancelledAt.toLocaleString('vi-VN')} (#{orderDetail.cancelledBy == "admin" ? "shop hủy" : "bạn hủy"})
            if orderDetail.cancelReason
              li
                span Lý do hủy:
                | #{orderDetail.cancelReason}
    div(class="invoice_table")
      .table-responsive
        table.table
          thead
            tr
              th Tên sản phẩm
              th Đơn giá
              th Số lượng
              th Tổng cộng
          tbody
            each item in orderDetail.items
              tr
                td
                  | #{item.name} 
                  if (item.variant && item.variant.length > 0)
                    | (
                    each v, index in item.variant
                      | #{v}
                      if (index < item.variant.length - 1)
                        | , 
                    | )
                td #{item.price.toLocaleString("vi-VN")}đ
                td #{item.quantity}
                td #{(item.price * item.quantity).toLocaleString("vi-VN")}đ
          tfoot
            tr
              td(colspan="3")
                b Tạm tính
              td
                b #{orderDetail.subTotal.toLocaleString("vi-VN")}đ
            if (orderDetail.discount)
              tr
                td(colspan="3") Giảm giá (#{orderDetail.coupon})
                td -#{orderDetail.discount.toLocaleString("vi-VN")}đ
            if orderDetail.pointDiscount > 0
              tr
                td(colspan="3") Giảm giá (#{orderDetail.usedPoint} điểm tích lũy)
                td -#{orderDetail.pointDiscount.toLocaleString("vi-VN")}đ
            tr
              td(colspan="3") Phí vận chuyển
              td #{orderDetail.shipping.fee.toLocaleString("vi-VN")}đ
            tr
              td(colspan="3")
                b Tổng tiền
              td
                b #{orderDetail.total.toLocaleString("vi-VN")}đ
    block
