include stars.pug

mixin product-list-item(item)
  div(class="product_list_item product_item_2 product_item")
    .row.align-items-center
      .col-md-5.col-sm-6.col-xxl-4
        div(class="product_img")
          a.d-block(href=`/product/detail/${item.slug}`)
            img.img-fluid.w-100(
              alt=item.name
              src=`${domainPublic}${item.images[0]}`
              )
          ul(class="discount_list")
            //- li.new new
            if (item.discount > 0)
              li.discount
                b -
                | #{item.discount}%
          //- Phải chọn màu/size ở trang chi tiết trước khi so sánh, yêu thích
          ul(class="btn_list")
            li
              a(href=`/product/detail/${item.slug}` title="So sánh")
                img.img-fluid(
                  alt="So sánh"
                  src="/client/assets/images/compare_icon_white.svg"
                  )
            li
              a(href=`/product/detail/${item.slug}` title="Yêu thích")
                img.img-fluid(
                  alt="Yêu thích"
                  src="/client/assets/images/love_icon_white.svg"
                  )
      .col-md-7.col-sm-6.col-xxl-8
        div(class="product_text")
          a.title(href=`/product/detail/${item.slug}`)
            | #{item.name}
          p.rating
            +stars(item)
            span (#{item.ratingCount} Đánh giá)
          p.price
            if (item.priceNew)
              | #{item.priceNew.toLocaleString("vi-VN")}đ
            if (item.priceOld)
            del #{item.priceOld.toLocaleString("vi-VN")}đ
          if (item.colorList.length > 0)
            ul.color
              each color in item.colorList
                li(style=`background:${color}`)
          p(class="short_description")
            | !{item.description}
          a(
            href=`/product/detail/${item.slug}`
            class="common_btn"
            )
            | Xem chi tiết
            i.fas.fa-long-arrow-right