include ../mixins/stars.pug

//
  ============================
    SPECIAL PRODUCT 2 START
    ==============================
//- Dữ liệu: blockData (tiêu đề, banner) + blockProductList (sản phẩm lấy theo blockData.getByCategory)
section(class="special_product_2 pt_85")
  .container
    .row
      .col-xl-6.col-sm-9
        div(class="section_heading_2 section_heading")
          h3
            | #{blockData.title.normal1}
            span #{blockData.title.highlight}
            | #{blockData.title.normal2}
      .col-xl-6.col-sm-3
        div(class="view_all_btn_area")
          a(
            href=blockData.linkViewAll
            class="view_all_btn"
            ) #{blockData.viewAll}
    .row(class="pt_15")
      if (blockData.banner)
        .col-xl-4.wow.fadeInLeft
          div(class="special_product_banner")
            img.img-fluid.w-100(
              alt=blockData.banner.title
              src=blockData.banner.image
              )
            .text
              h3 #{blockData.banner.title}
              p #{blockData.banner.subtitle}
              a(
                href=blockData.banner.button.link
                class="common_btn"
                )
                | #{blockData.banner.button.text}
                i.fas.fa-long-arrow-right
      .col-xl-8
        .row
          each item in blockProductList
            .col-md-6.wow.fadeInUp
              div(class="special_product_item")
                div(class="special_product_img")
                  img.img-fluid.w-100(
                    alt=item.name
                    src=`${domainPublic}${item.images[0]}`
                    )
                  if (item.discount > 0)
                    span.discount Giảm #{item.discount}%
                div(class="special_product_text")
                  a.title(href=`/product/detail/${item.slug}`) #{item.name}
                  span
                    +stars(item)
                  p
                    | #{item.priceNew.toLocaleString("vi-VN")}đ
                    if (item.priceOld > item.priceNew)
                      del #{item.priceOld.toLocaleString("vi-VN")}đ
//
  ============================
    SPECIAL PRODUCT 2 END
    ==============================
