# ==========================================================
# Bước 1 - build: cài đủ dependency và biên dịch TypeScript ra JavaScript
# ==========================================================
FROM node:22-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

# ==========================================================
# Bước 2 - runtime: chỉ dependency production + JavaScript đã biên dịch
# ==========================================================
FROM node:22-alpine

WORKDIR /app

ENV TZ=Asia/Ho_Chi_Minh

COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY --from=build /app/dist ./

# Thư mục media (gồm ảnh dữ liệu mẫu). Volume mới tạo sẽ lấy nội dung và quyền sở hữu từ đây,
# nên user node ghi được file upload
COPY --chown=node:node media ./media

# Không chạy bằng root
USER node

EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://127.0.0.1:4000/healthz > /dev/null || exit 1

CMD ["node", "index.js"]
